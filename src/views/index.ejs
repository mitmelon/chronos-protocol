<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chronos — Predict the Future. Verify the Outcome.</title>
  <meta name="description" content="Autonomous AI-powered prediction markets on Arc. Stake USDC on YES or NO. The oracle resolves with verifiable evidence." />
  <meta property="og:title" content="Chronos Protocol" />
  <meta property="og:description" content="Decentralised prediction markets powered by an autonomous AI oracle on Arc." />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Built Tailwind CSS (compiled from src/css/tailwind.css → public/css/build.css) -->
  <link rel="stylesheet" href="/assets/css/build.css" />

  <!--
    Runtime config injected by the server from environment variables.
    Only PUBLIC values (contract/chain addresses) are passed here.
    API keys, private keys, and database URIs are NEVER included.
  -->
  <script>
    window.CHRONOS_API_URL  = '<%= apiUrl %>';
    window.CHRONOS_CONTRACT = '<%= contractAddress %>';
    window.CHRONOS_USDC     = '<%= usdcAddress %>';
    window.CHRONOS_CHAIN_ID = <%= chainId %>;
    window.CHRONOS_EXPLORER = '<%= explorerUrl %>';
    window.CHRONOS_NETWORK  = '<%= networkName %>';
  </script>
</head>
<body>

<!-- ─── LANDING ──────────────────────────────────────────────────────────── -->
<div id="landing">

  <!-- Nav -->
  <nav class="landing-nav">
    <div class="landing-nav-brand">
      <div class="brand-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <span class="brand-name">Chronos</span>
      <span class="brand-badge"><%= networkName %></span>
    </div>
    <div class="landing-nav-actions">
      <a href="#features" class="nav-link-desktop">Features</a>
      <a href="#how-it-works" class="nav-link-desktop">How it works</a>
      <button id="launch-app-nav" class="btn btn-primary btn-sm">Launch App</button>
    </div>
  </nav>

  <!-- Hero -->
  <section class="landing-hero">
    <div class="landing-badge">
      <div class="dot dot-green pulse"></div>
      <span>Live on <%= networkName %></span>
    </div>

    <h1 class="landing-headline">
      Predict the Future.<br/>
      <span style="color:var(--accent)">Verify the Outcome.</span>
    </h1>

    <p class="landing-subtitle">
      Chronos is a decentralised prediction market protocol on Arc where an autonomous AI agent discovers events, creates markets, researches outcomes, and submits verifiable resolutions — all trustlessly enforced on-chain.
    </p>

    <div class="landing-ctas">
      <button id="launch-app-hero" class="btn btn-primary landing-cta-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        Open Markets
      </button>
      <% if (contractAddress) { %>
      <a href="<%= explorerUrl %>/address/<%= contractAddress %>" target="_blank" rel="noopener" class="btn btn-ghost landing-cta-secondary">
        View Contract
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
      <% } %>
    </div>

    <!-- Stats row -->
    <div class="landing-stats">
      <div class="landing-stat">
        <div class="landing-stat-value">YES/NO</div>
        <div class="landing-stat-label">Binary markets</div>
      </div>
      <div class="landing-stat-divider"></div>
      <div class="landing-stat">
        <div class="landing-stat-value"><%= feePct %>%</div>
        <div class="landing-stat-label">Fee on winners' profit only</div>
      </div>
      <div class="landing-stat-divider"></div>
      <div class="landing-stat">
        <div class="landing-stat-value">USDC</div>
        <div class="landing-stat-label">Native gas on Arc</div>
      </div>
      <div class="landing-stat-divider"></div>
      <div class="landing-stat">
        <div class="landing-stat-value">AI</div>
        <div class="landing-stat-label">Autonomous oracle</div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="landing-section landing-section-alt">
    <div class="landing-section-inner">
      <h2 class="landing-section-title">Built different.</h2>
      <div class="feature-grid">

        <div class="glass-card feature-card">
          <div class="feature-icon feature-icon-accent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
          </div>
          <h3 class="feature-title">Autonomous AI Oracle</h3>
          <p class="feature-desc">Gemini discovers events, generates precise YES/NO questions, gathers multi-source evidence, and submits resolutions with confidence scores — no human operator needed.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="feature-icon feature-icon-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3 class="feature-title">Fair Fee Structure</h3>
          <p class="feature-desc">The <%= feePct %>% protocol fee applies only to winners' profit, never to their original stake or losing positions. Losers walk away with nothing — no hidden charges.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="feature-icon feature-icon-accent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 11 12 14 22 4"/>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
          </div>
          <h3 class="feature-title">Full Refund Guarantee</h3>
          <p class="feature-desc">If the oracle misses its resolution deadline, any participant can trigger a refund. Everyone gets their exact USDC back, no questions asked.</p>
        </div>

        <div class="glass-card feature-card">
          <div class="feature-icon feature-icon-accent">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="feature-title">USDC on Arc</h3>
          <p class="feature-desc">Arc uses USDC as the native gas token. No ETH, no volatile assets — every bet, fee, and payout is denominated in stable USDC with sub-second finality.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="landing-section">
    <div class="landing-section-inner" style="text-align:center;max-width:760px">
      <h2 class="landing-section-title">How it works</h2>
      <p style="font-size:14px;color:var(--muted);margin-bottom:48px">Four steps from event to payout.</p>

      <div class="how-steps">
        <div class="how-step-line"></div>

        <div class="how-step">
          <div class="how-step-num">1</div>
          <div class="how-step-body">
            <div class="how-step-title">Discover</div>
            <p class="how-step-desc">The AI agent uses Parallel Search to find timely, verifiable future events and Gemini to turn them into precise YES/NO market questions — up to 3 per day.</p>
          </div>
        </div>

        <div class="how-step">
          <div class="how-step-num">2</div>
          <div class="how-step-body">
            <div class="how-step-title">Trade</div>
            <p class="how-step-desc">Users connect their wallets, deposit USDC, and choose YES or NO before the trading deadline. All funds are locked in the smart contract.</p>
          </div>
        </div>

        <div class="how-step">
          <div class="how-step-num">3</div>
          <div class="how-step-body">
            <div class="how-step-title">Resolve</div>
            <p class="how-step-desc">After the deadline the oracle gathers evidence from multiple sources and uses Gemini to propose an outcome. On-chain resolution fires when confidence exceeds 85%.</p>
          </div>
        </div>

        <div class="how-step">
          <div class="how-step-num">4</div>
          <div class="how-step-body">
            <div class="how-step-title">Claim</div>
            <p class="how-step-desc">Winners claim their pro-rata share minus a <%= feePct %>% fee on profit. If the oracle fails to resolve, anyone can mark the market refundable for a full refund.</p>
          </div>
        </div>
      </div>

      <button id="launch-app-bottom" class="btn btn-primary" style="margin-top:36px;padding:14px 40px;font-size:15px;font-weight:600">Start Predicting</button>
    </div>
  </section>

  <!-- Footer -->
  <footer class="landing-footer">
    <div class="landing-footer-brand">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>Chronos Protocol</span>
    </div>
    <div class="landing-footer-meta">
      <%= networkName %> &middot; Contract:
      <% if (contractAddress) { %>
        <a href="<%= explorerUrl %>/address/<%= contractAddress %>" target="_blank" class="footer-contract-link">
          <%= contractAddress.slice(0,6) %>…<%= contractAddress.slice(-4) %>
        </a>
      <% } else { %>
        <span style="color:var(--subtle)">Not deployed</span>
      <% } %>
    </div>
    <div class="landing-footer-note">Testnet only — no real funds</div>
  </footer>

</div>
<!-- END LANDING -->


<!-- ─── APP SHELL (hidden until Launch App is clicked) ───────────────────── -->
<div id="app" style="display:none">

  <div id="toast-container"></div>
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

  <div class="app-shell">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-logo">
        <img src="/assets/images/logo.svg" width="32" height="32" alt="Chronos logo" />
        <div>
          <div class="sidebar-title">Chronos</div>
          <div class="sidebar-tagline">Prediction Protocol</div>
        </div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-section-label">Protocol</div>
        <button class="nav-item active" data-page="overview">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Overview
        </button>
        <button class="nav-item" data-page="markets">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          Explore Markets
        </button>
        <button class="nav-item" data-page="positions">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          My Positions
        </button>
        <button class="nav-item" data-page="resolutions">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          Resolution Archive
        </button>

        <div class="nav-section-label" style="margin-top:12px">Intelligence</div>
        <button class="nav-item" data-page="agent">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          Agent Intelligence
        </button>

        <div class="nav-section-label" style="margin-top:12px">System</div>
        <button class="nav-item" data-page="settings">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          Settings
        </button>
      </nav>

      <div class="sidebar-footer">
        <div style="font-size:10px;color:var(--subtle);text-align:center">
          <%= networkName %> &middot; Chronos v1
        </div>
      </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
      <header class="topbar">
        <button id="sidebar-toggle" class="btn btn-ghost btn-sm" style="display:none;padding:6px 10px">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <div style="display:flex;align-items:center;gap:8px">
          <span style="font-size:12px;color:var(--muted)">
            <span class="dot dot-green pulse"></span><%= networkName %>
          </span>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <div id="usdc-balance-display" style="font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;display:none">
            <span id="usdc-balance-value">—</span> USDC
          </div>
          <div id="wallet-btn-container"></div>
        </div>
      </header>

      <main class="page-content" id="page-root">
        <div class="empty-state">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          <h3>Loading Chronos…</h3>
          <p>Connecting to Arc Testnet</p>
        </div>
      </main>
    </div>
  </div>

  <div id="market-modal" class="modal-overlay" style="display:none">
    <div class="modal-sheet" id="market-modal-content"></div>
  </div>

</div>
<!-- END APP -->


<script>
  // Landing → App transition — no page reload
  function launchApp() {
    document.getElementById('landing').style.display = 'none';
    document.getElementById('app').style.display = 'block';
    document.body.style.overflow = '';
  }
  document.getElementById('launch-app-nav').addEventListener('click', launchApp);
  document.getElementById('launch-app-hero').addEventListener('click', launchApp);
  document.getElementById('launch-app-bottom').addEventListener('click', launchApp);

  // Returning users / shared links skip the landing entirely
  if (window.location.hash && window.location.hash.length > 1) launchApp();

  // Mobile sidebar toggle
  const sidebarEl   = document.getElementById('sidebar');
  const backdropEl  = document.getElementById('sidebar-backdrop');
  const toggleBtn   = document.getElementById('sidebar-toggle');
  function openSidebar()  { sidebarEl.classList.add('open'); backdropEl.classList.add('visible'); document.body.style.overflow = 'hidden'; }
  function closeSidebar() { sidebarEl.classList.remove('open'); backdropEl.classList.remove('visible'); document.body.style.overflow = ''; }
  if (toggleBtn)  toggleBtn.addEventListener('click', openSidebar);
  if (backdropEl) backdropEl.addEventListener('click', closeSidebar);
  // Close sidebar when a nav item is clicked on mobile
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => { if (window.innerWidth <= 768) closeSidebar(); });
  });
</script>

<!-- App bundle loads after landing so the hero renders immediately -->
<script type="module" src="/assets/js/app.js"></script>

</body>
</html>
