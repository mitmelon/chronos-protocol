# ── Network: one codebase, testnet or mainnet, chosen here ───────────────────
ARC_NETWORK=testnet                 # testnet | mainnet
# Optional overrides (defaults come from the ARC_NETWORK preset):
# ARC_CHAIN_ID=
# ARC_RPC_URL=                     # one URL or a comma-separated list (tried in order). Defaults to the official Arc endpoints
# ARC_PUBLIC_RPC_URL=               # RPC shown to browsers when adding the network to a wallet
# ARC_EXPLORER_URL=
# ARC_NETWORK_NAME=
# VITE_ARC_USDC_ADDRESS=
VITE_FACTORY_ADDRESS=               # deployed Chronos contract on the selected network

# ── Oracle wallet (pays gas in USDC; NEVER commit) ───────────────────────────
ORACLE_PRIVATE_KEY=

# ── Security (REQUIRED in production and on mainnet) ─────────────────────────
SESSION_SECRET=                     # 32+ random characters: openssl rand -hex 32
WORKER_SECRET=
CORS_ORIGINS=http://localhost:8080

# ── AI agent ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash       # agent model
# GEMINI_VERIFIER_MODEL=            # independent second opinion (defaults to GEMINI_MODEL)
PARALLEL_API_KEY=

# ── Agent tuning (all optional) ──────────────────────────────────────────────
# AGENT_MAX_MARKETS_PER_DAY=3
# AGENT_DISCOVERY_ON_START=false    # true = run discovery whenever the worker starts (careful with node --watch)
# AGENT_MAX_STEPS=16                # cap on agent reasoning/tool steps per run
# AGENT_MIN_PROBABILITY=0.2         # outcomes outside 20%-80% are rejected as too predictable
# AGENT_MAX_PROBABILITY=0.8
# AGENT_MIN_CONFIDENCE=0.85
# AGENT_MIN_EVIDENCE_SOURCES=2
# AGENT_EVENT_SETTLE_DELAY_MINUTES=60
# AGENT_MANUAL_COOLDOWN_MINUTES=10
# AGENT_DISCOVERY_SCHEDULE="0 9 * * *"
# AGENT_RESOLUTION_SCHEDULE="*/30 * * * *"
# AGENT_KEEPER_SCHEDULE="*/15 * * * *"

# ── Infra ────────────────────────────────────────────────────────────────────
# Server + credentials only. The database name is separate (below).
MONGODB_URI=mongodb://admin:password@localhost:27017
MONGODB_DB_NAME=chronos
# Login database for the user. Defaults to "admin" when the URI has credentials.
# MONGODB_AUTH_SOURCE=admin
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
PORT=5173

# ── Gas and rate-limit guards ────────────────────────────────────────────────
# AGENT_MAX_TX_COST_USDC=0.25       # refuse any single transaction estimated above this (protects a small wallet)
# AGENT_KEEPER_CLOSE_TRADING=false  # resolveMarket closes trading itself; a separate closeTrading tx just burns gas
# GEMINI_MAX_RPM=10                 # client-side requests/minute so free-tier quotas are never hit
# AGENT_MAX_PROPOSALS_PER_RUN=6     # cap on market proposals per discovery run (saves tokens)
# AGENT_RETRY_CAP_MINUTES=120       # the oracle retries an unresolved market at most this often, until the deadline
# AGENT_FINAL_ATTEMPT_LEAD_MINUTES=90  # one last, bigger attempt this long before the deadline
# AGENT_AUTO_PUBLISH=true           # publish approved questions on-chain (pending questions are retried from the database)
