# ─── Chronos Protocol — Environment Variables ──────────────────────────────
# Copy this to .env and fill in your values before running.
# Never commit .env to version control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/chronos

# ── Arc Blockchain ──────────────────────────────────────────────────────────
# The proxy (RPC_PROXY_*) is auto-provisioned in Arc Studio sandboxes.
# For development outside Arc Studio, set ARC_RPC_URL directly.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io

# USDC on Arc (same address on mainnet and testnet)
# VITE_ prefix exposes it to the browser via import.meta.env.VITE_ARC_USDC_ADDRESS
VITE_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Deployed Chronos contract address (set after deploy)
VITE_FACTORY_ADDRESS=

# ── Protocol ────────────────────────────────────────────────────────────────
PROTOCOL_TREASURY=
PROTOCOL_FEE_BPS=500
GRACE_PERIOD_SECONDS=15552000

# ── Oracle ──────────────────────────────────────────────────────────────────
# Private key of the wallet registered as oracle in the contract constructor.
# NEVER commit this value.
ORACLE_PRIVATE_KEY=

# ── Worker Auth ─────────────────────────────────────────────────────────────
WORKER_SECRET=change-me-in-production

# ── AI: Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Discovery: Parallel Search API ──────────────────────────────────────────
PARALLEL_API_KEY=

# ── Agent Behaviour ──────────────────────────────────────────────────────────
AGENT_MAX_MARKETS_PER_DAY=3
AGENT_MIN_CONFIDENCE=0.85
AGENT_RESOLUTION_LOOKBACK_HOURS=48

# Cron schedules (UTC)
AGENT_DISCOVERY_SCHEDULE=0 9 * * *
AGENT_RESOLUTION_SCHEDULE=*/30 * * * *
AGENT_KEEPER_SCHEDULE=*/15 * * * *

# ── Redis (required by BullMQ worker) ────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
