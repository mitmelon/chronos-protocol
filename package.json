{
  "name": "chronos-protocol",
  "version": "1.0.0",
  "description": "Autonomous AI-operated prediction markets on Arc — USDC, verifiable resolutions, on-chain settlement.",
  "main": "server.js",
  "scripts": {
    "start":          "node server.js",
    "start:worker":   "node worker.js",
    "dev":            "node --watch server.js",
    "dev:worker":     "node --watch worker.js",
    "build:css":      "tailwindcss -i ./src/css/tailwind.css -o ./public/css/build.css --minify",
    "watch:css":      "tailwindcss -i ./src/css/tailwind.css -o ./public/css/build.css --watch",
    "build":          "npm run build:css",
    "test":           "forge test --root contracts"
  },
  "keywords": ["prediction-market", "arc", "usdc", "ai-oracle", "defi", "bullmq"],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors":       "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static":     "^8.0.4",
    "@fastify/view":       "^10.0.0",
    "bullmq":              "^5.12.6",
    "dotenv":              "^16.4.5",
    "ejs":                 "^3.1.10",
    "fastify":             "^4.28.0",
    "ioredis":             "^5.4.1",
    "mongodb":             "^6.7.0",
    "pino-pretty":         "^11.2.0",
    "uuid":                "^10.0.0",
    "viem":                "^2.19.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.4"
  }
}
